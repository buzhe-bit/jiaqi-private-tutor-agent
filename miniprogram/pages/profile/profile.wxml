<view class="page-shell">
  <text class="eyebrow">{{modeLabel}}</text>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="page-title">我的学习档案</view>
  <view class="stats">
    <view class="stat"><text class="stat-number">{{completed}}</text><text class="stat-label">已完成</text></view>
    <view class="stat"><text class="stat-number">{{due}}</text><text class="stat-label">待复习</text></view>
    <view class="stat"><text class="stat-number">{{unstable}}</text><text class="stat-label">需要再练</text></view>
  </view>
  <view class="card">
    <view class="card-title">现在保存了什么</view>
    <view class="lead">每题的第一次表达、卡点判断、教学干预、最终改写、掌握状态和下次复习时间。完整对话保留在训练记录中，这里只呈现后续复习真正需要的摘要。</view>
  </view>
  <view class="card">
    <view class="card-title">最近卡点</view>
    <view wx:for="{{weaknesses}}" wx:key="topic" class="weakness">
      <text class="weakness-title">{{item.thinker ? item.thinker + ' · ' : ''}}{{item.topic}}</text>
      <text class="lead">{{item.summary}}</text>
      <text class="weakness-status">{{item.status}}</text>
    </view>
    <view wx:if="{{!weaknesses.length}}" class="lead">完成训练后，系统会把需要复习的概念关系整理到这里。</view>
  </view>
</view>
