<view class="page-shell">
  <text class="eyebrow">今日已完成 {{completed}} 题</text>
  <view class="page-title">{{baseReached ? '基础训练完成，还可以继续' : '今天继续练一题'}}</view>
  <view class="lead">题目在新题、关系题和旧卡点复习之间动态选择；三题是基础量，不是上限。</view>
  <view class="mode-notice">
    <text>{{mode === 'local-demo' ? '本地演示' : '真实私教'}}</text>
    <text> · {{modeLabel}}</text>
  </view>

  <view wx:if="{{needsInvite}}" class="card invite-card">
    <view class="card-title">输入试用码开始</view>
    <view class="lead">试用码只保存在这台设备，用来隔离你的学习档案。</view>
    <input class="invite-input" value="{{inviteCodeInput}}" placeholder="请输入试用码" maxlength="200" bindinput="onInviteInput" />
    <button class="primary" bindtap="beginTrial" loading="{{loading}}">开始试用</button>
  </view>

  <view wx:if="{{!needsInvite && recommendation}}" class="card">
    <view class="meta-row">
      <text class="tag">{{active ? '继续未完成' : kindLabel}}</text>
      <text>{{active ? '进行中' : '为你推荐'}}</text>
    </view>
    <view class="card-title">{{recommendation.question}}</view>
    <view class="lead">{{recommendation.reason}}</view>
    <button class="primary" bindtap="start" loading="{{loading}}">{{active ? '继续这道题' : '开始这道题'}}</button>
  </view>

  <view wx:elif="{{!needsInvite && !loading}}" class="empty">
    <view>下一题还没有准备好</view>
    <button class="secondary" bindtap="refresh">重新获取推荐</button>
    <button wx:if="{{canChangeInvite}}" class="text-action" bindtap="changeInvite">重新输入试用码</button>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
