PORT=8787

# local demo: mock + memory; pilot: cloudbase database + optional Feishu mirror
COACH_PROVIDER=mock
RECORD_PROVIDER=memory
MIRROR_PROVIDER=none

# CloudBase AI HTTP API (server-side only)
CLOUDBASE_ENV_ID=
CLOUDBASE_API_KEY=
CLOUDBASE_PROVIDER=cloudbase
CLOUDBASE_MODEL=deepseek-v4-flash
CLOUDBASE_DATABASE_COLLECTION=coach_sessions

# Each key is a private invite token. Do not use names or phone numbers.
INVITE_CODES_JSON={"demo":{"participantCode":"DEMO","cohort":"demo"}}
SESSION_SIGNING_SECRET=

# Feishu Base (server-side only)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_TOKEN=
FEISHU_TABLE_ID=
